{
  "name": "mobil_alkalmazasfejlesztes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && expo start'",
    "android": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && expo run:android'",
    "ios": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && expo run:ios'",
    "web": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && expo start --web'",
    "lint": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && eslint .'",
    "format": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && prettier --write .'",
    "test": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && jest'",
    "e2e": "bash -c 'unset npm_config_prefix && . $HOME/.nvm/nvm.sh && nvm use 20 && detox build -c android.emu.debug && detox test -c android.emu.debug'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.28",
    "expo": "~55.0.4",
